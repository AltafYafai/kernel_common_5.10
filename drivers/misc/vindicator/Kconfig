#
# Vindicator custom drivers
# Author: GrayRavens
#

menu "Vindicator — GrayRavens custom kernel drivers"

config VINDICATOR
	tristate "Vindicator — sysfs enforcement framework"
	help
	  Vindicator is a lightweight enforcement framework that helps
	  kernel modules defend critical sysfs/procfs tunables against
	  rogue vendor init.rc scripts and HAL overrides.
	  
	  Uses a per-target hrtimer-based watchdog with adaptive backoff,
	  RCU-protected target list, and debugfs visibility.
	  
	  Say Y/M here — other Vindicator drivers depend on this.

config VINDICATOR_NOCTURNE
	tristate "Nocturne — screen-state power saving"	depends on VINDICATOR && PM_SLEEP && CPU_FREQ_GOV_ZENITH
	help
	  Nocturne detects screen-on/off transitions via the PM suspend
	  notifier chain and applies configurable CPU/cpuset
	  throttling when the display is off.
	  
	  Integrates with the Zenith profile system so that GAMING
	  profile disables throttling even when the screen is off.

config VINDICATOR_EQUILIBRIUM
	tristate "Equilibrium — profile-aware memory/swap tuning"
	depends on VINDICATOR
	help
	  Equilibrium adjusts vm_swappiness, dirty_ratio, and
	  vfs_cache_pressure dynamically based on the active Zenith
	  profile:
	    POWER_SAVE  → swappiness=10, aggressive writeback
	    BALANCED    → swappiness=60 (Linux default)
	    GAMING      → swappiness=20, defer writeback
	    PERFORMANCE → swappiness=20, defer writeback

config VINDICATOR_HERALD
	tristate "Herald — kernel-to-userspace property relay"
	depends on VINDICATOR && SYSFS
	help
	  Herald provides a sysfs interface at /sys/kernel/herald/
	  where kernel modules can queue Android property changes.
	  A userspace daemon or init.rc script reads the queue and
	  applies them with setprop(1) — SELinux-safe because no
	  call_usermodehelper is involved.

endmenu
