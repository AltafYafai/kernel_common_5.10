#
# Vindicator custom drivers
# Author: GrayRavens
#

menu "Vindicator — GrayRavens custom kernel drivers"

config VINDICATOR
	tristate "Vindicator — sysfs enforcement framework"
	help
	  Vindicator is a lightweight enforcement framework that helps
	  kernel modules defend critical sysfs/procfs tunables against
	  rogue vendor init.rc scripts and HAL overrides.
	  
	  Uses a per-target hrtimer-based watchdog with adaptive backoff,
	  RCU-protected target list, and debugfs visibility.
	  
	  Say Y/M here — other Vindicator drivers depend on this.

config VINDICATOR_NOCTURNE
	tristate "Nocturne — screen-state power saving"
	depends on VINDICATOR && PM_SLEEP && CPU_FREQ_GOV_ZENITH
	help
	  Nocturne detects screen-on/off transitions via the PM suspend
	  notifier chain and applies configurable CPU/cpuset
	  throttling when the display is off.
	  
	  Integrates with the Zenith profile system so that GAMING
	  profile disables throttling even when the screen is off.

config VINDICATOR_EQUILIBRIUM
	tristate "Equilibrium — profile-aware memory/swap tuning"
	depends on VINDICATOR
	help
	  Equilibrium adjusts vm_swappiness, dirty_ratio, and
	  vfs_cache_pressure dynamically based on the active Zenith
	  profile:
	    POWER_SAVE  → swappiness=10, aggressive writeback
	    BALANCED    → swappiness=60 (Linux default)
	    GAMING      → swappiness=20, defer writeback
	    PERFORMANCE → swappiness=20, defer writeback

config VINDICATOR_HERALD
	tristate "Herald — kernel-to-userspace property relay"
	depends on VINDICATOR && SYSFS
	help
	  Herald provides a sysfs interface at /sys/kernel/herald/
	  where kernel modules can queue Android property changes.
	  A userspace daemon or init.rc script reads the queue and
	  applies them with setprop(1) — SELinux-safe because no
	  call_usermodehelper is involved.

config VINDICATOR_TARGETS
	tristate "Vindicator — built-in enforcement targets"
	depends on VINDICATOR
	default y
	help
	  Registers common sysfs/procfs enforcement targets with the
	  Vindicator watchdog framework:
	    - cpufreq governor  → ensures it stays "zenith"
	    - TCP congestion    → ensures it stays "bbr"
	    - read_ahead_kb     → ensures block read-ahead stays tuned
	    - sched_boost       → ensures boost stays at 0
	  
	  All paths and expected values are configurable via module
	  params at /sys/module/vindicator_targets/parameters/.
	  
	  Say Y here to auto-defend critical tunables at boot.

config VINDICATOR_KIRYUU
	tristate "Kiryuu — native root command execution engine"
	depends on VINDICATOR
	help
	  Kiryuu executes shell commands from kernel context as UID 0 via
	  call_usermodehelper(), bypassing SELinux constraints.
	  Used internally by Kage, Tsuki, and other drivers that need
	  to invoke KernelSU/SUSFS userspace helpers.

config VINDICATOR_KAGE
	tristate "Kage — SUSFS path and mount hiding helper"
	depends on VINDICATOR_KIRYUU
	help
	  Kage provides a kernel API to dynamically hide filesystem paths,
	  mounts, and packages via SUSFS (KernelSU Security File System).
	  All operations are executed through Kiryuu.

config VINDICATOR_TSUKI
	tristate "Tsuki — kernel-level Android property manipulation"
	depends on VINDICATOR_KIRYUU
	help
	  Tsuki provides a workqueue-based interface to set Android system
	  properties via ksud resetprop, bypassing SELinux and
	  property_service restrictions.

config VINDICATOR_OTO
	tristate "Oto — audio thread SCHED_FIFO boost and PM QoS"
	depends on VINDICATOR && PM
	help
	  Oto detects audio server threads and promotes them to SCHED_FIFO
	  with configurable priority. Engages a PM QoS latency lock to
	  prevent deep idle states during audio playback, and maintains
	  dynamic CPUSet masks for audio thread affinity.

config VINDICATOR_SEN
	tristate "Sen — touch-based gaming frequency boost"
	depends on VINDICATOR && CPU_FREQ && ANDROID_VENDOR_HOOKS
	help
	  Sen intercepts touch input events and temporarily boosts CPU
	  frequency to maximum via the schedutil vendor hook.
	  Boost duration is configurable and refreshed on each touch.

config VINDICATOR_SHUN
	tristate "Shun — boot-time CPU frequency boost"
	depends on VINDICATOR && CPU_FREQ
	help
	  Shun locks all online CPU policies to maximum frequency for a
	  configurable duration after boot using PM QoS requests.
	  Gracefully releases the lock after the boost period expires.

config VINDICATOR_KAISEI
	tristate "Kaisei — panic-to-recovery redirector"
	depends on VINDICATOR
	help
	  Kaisei registers a panic notifier that intercepts kernel panics
	  and BUG() conditions, redirecting the subsequent reboot into
	  recovery mode via do_kernel_restart().

	  On supported platforms (Qualcomm, MTK, Exynos, etc.), the
	  platform restart handler writes the appropriate magic values
	  to PMIC/RTC registers that the bootloader checks — causing
	  a boot into recovery mode instead of a normal reboot.

	  The reboot command and enable/disable are configurable via
	  module parameters at /sys/module/kaisei/parameters/.

	  Say Y here to ensure kernel panics land you in recovery
	  instead of a bootloop.

config VINDICATOR_YORU
	tristate "Yoru — watchdog panic generator"
	depends on VINDICATOR
	help
	  Yoru starts a kernel timer on boot.  Userspace must pet the
	  watchdog periodically by writing to
	  /sys/module/yoru/parameters/pet.  If the timer expires,
	  Yoru calls panic() — which Kaisei (回生) intercepts and
	  redirects into recovery mode.

	  Together Yoru + Kaisei cover both kernel panics AND hangs:
	    - Kernel panic  → Kaisei redirects to recovery
	    - Kernel hang    → Yoru triggers panic → Kaisei redirects

	  DISABLED BY DEFAULT (yoru.enabled=0).  To use Yoru, set
	  yoru.enabled=1 AND configure an init.rc script to
	  periodically write to /sys/module/yoru/parameters/pet.
	  Without a userspace pet, the watchdog will fire after the
	  default 60-second timeout.

	  The timeout and enable/disable are configurable via module
	  parameters at /sys/module/yoru/parameters/.

	  Say Y here if you want hung systems to also land in recovery.

endmenu
