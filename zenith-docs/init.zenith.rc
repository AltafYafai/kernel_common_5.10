# init.zenith.rc — Zenith governor runtime tunables
#
# Drop in /vendor/etc/init/init.zenith.rc on the device, then merge into
# your existing init.mtxxxx.rc init scripts.  Path globs (`*`) require Android 10+ init.
# On older init or stricter SELinux, replace each glob with explicit
# policy paths (e.g. policy0, policy4, policy6) for your device.
#
# Ordering: triggered on `init` so the writes land before any userspace
# workload starts.  Most knobs are hot-readable; the kernel applies the
# new value on the next decision tick.
#
# All knobs default to sensible per-cluster values inside the kernel.
# This file only OVERRIDES where a phone-class default differs from the
# generic default, and provides every other knob commented out as a
# discoverable reference.
#
# To find your device's policy indices:
#   ls /sys/devices/system/cpu/cpufreq/
# Typical Snapdragon 8-gen / Tensor split is policy0 (little) +
# policy4 (big) +/- policy7 (prime).  MTK Dimensity is usually
# policy0 + policy4 + policy7 too.
#
# Path glob `policy*` covers all clusters with a single line.  Use
# explicit paths if a knob should differ per cluster (e.g. profile=
# performance on big, battery on little).

on init
    # ----- Profile -----
    # 'performance' | 'balanced' | 'battery' | 'legacy' | 'custom'
    # Picking a profile here resets the per-knob tunables to that
    # profile's preset; subsequent writes below override individual
    # knobs back to your taste.  Leave commented to keep cmdline /
    # built-in CUSTOM defaults.
    #
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/profile balanced

    # ----- Boot boost (one-shot, decays past deadline) -----
    # Pin freq to policy->max for this many ms after kernel boot.
    # 0 disables.  Recommended 30000 (30s).  Gated by screen_state and
    # input_boost_big_only — small clusters skip if big_only=1.
    write /sys/devices/system/cpu/cpufreq/policy*/zenith/boot_boost_ms 30000

    # ----- Auto-tune -----
    # Worker classifies workload every 10s and switches profiles based on
    # input-event rate, saturation load %, and (if scenario=1) game/audio/
    # camera/render flags.  Default ON.
    write /sys/devices/system/cpu/cpufreq/policy*/zenith/auto_tune 1
    write /sys/devices/system/cpu/cpufreq/policy*/zenith/auto_tune_scenario 1

    # ----- Awareness flags (default OFF, opt-in) -----
    # Each adds a per-tier floor or cap.  Userspace must signal the
    # state via the `*_active` knobs.  Leave OFF unless you have an
    # init script that toggles them based on running app.
    #
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/render_aware 1
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/audio_aware 1
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/camera_aware 1
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/game_mode 0
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/psi_aware 1

    # ----- Frame pace floor (adaptive 60/90/120/144 Hz) -----
    # Userspace writes the current vblank period in microseconds whenever
    # the panel changes refresh rate; 0 disables.  60Hz=16666, 90Hz=11111,
    # 120Hz=8333, 144Hz=6944.  Pair with frame_pace_floor_pct (0..100,
    # default 0 = disabled) — typical 50.
    #
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/frame_budget_us 8333
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/frame_pace_floor_pct 50

    # ----- Permissions for runtime userspace tweaks -----
    # Open the knobs you want HALs / app-aware daemons to write to.
    # The chown / chmod has to happen AFTER the governor is registered;
    # zenith register from cpufreq_init() is well before init.rc runs,
    # so these are safe at boot time.
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/profile
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/screen_state
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/thermal_state
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/render_aware
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/audio_aware
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/camera_active
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/game_mode
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/frame_budget_us
    chown system system /sys/devices/system/cpu/cpufreq/policy0/zenith/frame_pace_floor_pct
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/profile
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/screen_state
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/thermal_state
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/render_aware
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/audio_aware
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/camera_active
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/game_mode
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/frame_budget_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/zenith/frame_pace_floor_pct
    # Repeat for policy4, policy6, policy7 as your device requires.

# Tighten down-rate & dial in profile once boot completes, so stock
# Android UI feels snappy mid-session without paying for the boot-pin
# energy cost any longer than necessary.
on property:sys.boot_completed=1
    # Optional: switch to balanced profile once boot finishes.  Boot
    # boost above already auto-decays at deadline so this is mostly
    # a tidy-up.
    # write /sys/devices/system/cpu/cpufreq/policy*/zenith/profile balanced

    # Drop boot_boost early if we want it cleared (the kernel ignores
    # writes-while-armed past the deadline anyway, but explicit clear
    # frees any future userspace from worrying about residual state).
    write /sys/devices/system/cpu/cpufreq/policy*/zenith/boot_boost_ms 0

# ----- Reference: every Zenith knob, defaults shown -----
# (Listed for grep / discovery.  Do not uncomment unless you actually
#  want to override that knob.)
#
# Cluster cadence
#   up_rate_limit_us           = 100
#   down_rate_limit_us         = 4000
#   up_threshold               = 75
#   up_threshold_hispeed       = 0       (0=disabled)
#   down_threshold             = 60
#   sampling_down_factor       = 2
#   up_delay_us                = 4000
#
# Hispeed tier
#   hispeed_freq               = 0       (kHz; 0 -> use hispeed_freq_pct)
#   hispeed_freq_pct           = 55      (% of policy->max when freq=0)
#   hispeed_load               = 65
#   hispeed_hyst_pct           = 10      (exit-side hysteresis margin)
#   hispeed_entry_streak       = 0       (0=disabled, otherwise N samples)
#
# Climb / step
#   climb_mode                 = 0       (0=SNAP, 1=STEP)
#   freq_step_pct              = 5
#
# IO / iowait
#   io_is_busy                 = 1
#   iowait_boost_min           = 125
#   iowait_stack_pct           = 50
#   ignore_nice_load           = 0
#
# Power / bias
#   powersave_bias             = 0
#   bias_load_threshold        = 50
#   light_load_freq            = 0       (kHz; 0=disabled)
#   light_load_threshold       = 20
#   efficient_freq             = 0       (kHz CSV ladder; 0=disabled)
#   boost_exit_extend          = 1
#
# Display / thermal
#   screen_state               = 1       (1=on, 0=off; FB notifier auto)
#   screen_auto                = 1       (FB notifier wired)
#   thermal_state              = 0       (1=throttled view, sysfs hint)
#   thermal_auto               = 1
#   thermal_util_derate        = 1
#
# Input boost
#   input_boost_ms             = 80
#   input_boost_decay_ms       = 30
#   input_boost_big_only       = 1
#   input_boost_cap_pct        = 80      (0=pin to max)
#
# kcpustat / util math
#   kcpustat_window_us         = 4000
#   kcpustat_filter_shift      = 1
#   kcpustat_hispeed_enable    = 1
#   util_math_v2               = 1
#   predict_util_pct           = 0       (1-step linear util predictor)
#
# uclamp respect
#   uclamp_min_respect         = 1
#   uclamp_max_respect         = 1
#
# Auto-tune
#   auto_tune                  = 1
#   auto_tune_sat_load_pct     = 70
#   auto_tune_hi_sat_pct       = 60
#   auto_tune_lo_sat_pct       = 10
#   auto_tune_hi_events_x2     = 4
#   auto_tune_lo_events_x2     = 1
#   auto_tune_scenario         = 0       (1=enable scenario flags)
#
# Profile
#   profile                    = custom  (or performance/balanced/battery/legacy)
#
# Awareness floors
#   render_aware               = 0
#   render_floor_pct           = 70
#   audio_aware                = 0
#   audio_floor_pct            = 0
#   audio_cap_pct              = 0
#   camera_aware               = 0
#   camera_active              = 0
#   camera_floor_pct           = 0
#   game_mode                  = 0
#
# PSI / memstall
#   psi_aware                  = 0
#   psi_mem_thresh             = 50
#
# Boot / frame pacing
#   boot_boost_ms              = 0       (overridden to 30000 above)
#   frame_budget_us            = 0       (vblank period; 0=disabled)
#   frame_pace_floor_pct       = 0
